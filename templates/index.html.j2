<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{ site_title }}</title>
</head>
<body>
  <h1>{{ site_title }}</h1>
  <p>Сервер: <b>{{ inventory_hostname }}</b></p>
  <p>Роль: {{ server_role | default('не задана') }}</p>
  <p>IP: {{ ansible_facts["default_ipv4"]["address"] }}</p>
  <p>ОС: {{ ansible_facts["distribution"] }} {{ ansible_facts["distribution_version"] }}</p>

  {% if server_role == 'primary' %}
  <p>Это главный сервер.</p>
  {% else %}
  <p>Это резервный сервер.</p>
  {% endif %}

  <h3>Все веб-серверы:</h3>
  <ul>
  {% for host in groups['web'] %}
    <li>{{ host }}</li>
  {% endfor %}
  </ul>
  <p>{{ site_footer }}</p>
</body>
</html>
